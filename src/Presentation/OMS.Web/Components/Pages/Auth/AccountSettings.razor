@page "/account"
@attribute [Authorize]
@using System.Security.Claims

<PageTitle>Account Settings - OMS</PageTitle>

<h1><i class="bi bi-person-circle me-2 text-primary"></i>Account Settings</h1>
<p class="text-muted">Your account details.</p>

<AuthorizeView>
    <Authorized>
        <div class="card shadow-sm" style="max-width: 480px;">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Display name</dt>
                    <dd class="col-sm-8">@context.User.Identity?.Name</dd>
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8">@context.User.FindFirst(ClaimTypes.Role)?.Value</dd>
                </dl>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
