@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using OMS.Application.Interfaces
@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService

<PageTitle>Dashboard - OMS</PageTitle>

<h1><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h1>
<p class="text-muted">An overview of your organization.</p>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Employees</div>
                    <div class="fs-3 fw-bold">@(_employeeCount?.ToString() ?? "—")</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="btn btn-sm btn-outline-primary" href="employees">
                    <i class="bi bi-arrow-right"></i>Manage Employees
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div>
                    <div class="text-muted small">Departments</div>
                    <div class="fs-3 fw-bold">@(_departmentCount?.ToString() ?? "—")</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="btn btn-sm btn-outline-primary" href="departments">
                    <i class="bi bi-arrow-right"></i>Manage Departments
                </a>
            </div>
        </div>
    </div>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="stat-icon bg-warning-subtle text-warning">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Administration</div>
                            <div class="fs-6 fw-semibold">User Accounts</div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <a class="btn btn-sm btn-outline-primary" href="admin/users">
                            <i class="bi bi-arrow-right"></i>Manage Users
                        </a>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private int? _employeeCount;
    private int? _departmentCount;

    protected override async Task OnInitializedAsync()
    {
        _employeeCount = (await EmployeeService.GetAllAsync()).Count;
        _departmentCount = (await DepartmentService.GetAllAsync()).Count;
    }
}
