@page "/departments/merge"
@attribute [Authorize]
@rendermode InteractiveServer
@using OMS.Application.Dtos
@using OMS.Application.Interfaces
@inject IDepartmentService DepartmentService
@inject IDepartmentMergeService MergeService
@inject NavigationManager Navigation

@* Moving every employee out of the source department and deleting it are two separate
   writes that must both succeed or neither should - MergeAsync wraps them in a single
   database transaction so a failure partway through leaves nothing changed. *@

<PageTitle>Merge Departments - OMS</PageTitle>

<h1><i class="bi bi-arrow-left-right me-2 text-primary"></i>Merge Departments</h1>
<p class="text-muted">Move every employee from one department into another, then remove the original department.</p>

@if (departments is null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Merge failed:</strong> @_errorMessage
        </div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@_successMessage</div>
    }

    <div class="card shadow-sm col-md-6">
        <div class="card-body">
            <EditForm Model="_model" OnValidSubmit="HandleMergeAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Source department (will be deleted)</label>
                    <InputSelect class="form-select" @bind-Value="_model.SourceDepartmentId">
                        <option value="">-- Select --</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.Id">@department.Name (@department.Code)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.SourceDepartmentId" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Target department (receives the employees)</label>
                    <InputSelect class="form-select" @bind-Value="_model.TargetDepartmentId">
                        <option value="">-- Select --</option>
                        @foreach (var department in departments)
                        {
                            <option value="@department.Id">@department.Name (@department.Code)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.TargetDepartmentId" />
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-left-right"></i>Merge</button>
                <a class="btn btn-secondary" href="departments">Cancel</a>
            </EditForm>
        </div>
    </div>
}

@code {
    private IReadOnlyList<DepartmentDto>? departments;
    private MergeDepartmentsFormModel _model = new();
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        departments = await DepartmentService.GetAllAsync();
    }

    private async Task HandleMergeAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await MergeService.MergeAsync(_model);
            _successMessage = "Departments merged successfully.";
            departments = await DepartmentService.GetAllAsync();
            _model = new MergeDepartmentsFormModel();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
