@page "/departments"
@attribute [Authorize]
@rendermode InteractiveServer
@using OMS.Application.Dtos
@using OMS.Application.Interfaces
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Reference implementation of the "edit via dedicated page" CRUD pattern: Add/Edit
   navigate to DepartmentEdit.razor instead of opening a modal. Compare with
   EmployeeList.razor for the modal alternative. *@

<PageTitle>Departments - OMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Departments</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="departments/merge">Merge Departments</a>
        <a class="btn btn-primary" href="departments/edit">Add Department</a>
    </div>
</div>

@if (departments is null)
{
    <p><em>Loading...</em></p>
}
else if (departments.Count == 0)
{
    <p class="text-muted">No departments yet.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Active</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in departments)
            {
                <tr>
                    <td>@department.Name</td>
                    <td>@department.Code</td>
                    <td>
                        @if (department.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="@($"departments/edit/{department.Id}")">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(department)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<DepartmentDto>? departments;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        departments = await DepartmentService.GetAllAsync();
    }

    private async Task DeleteAsync(DepartmentDto department)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete department '{department.Name}'?");
        if (!confirmed)
        {
            return;
        }

        await DepartmentService.DeleteAsync(department.Id);
        await LoadAsync();
    }
}
