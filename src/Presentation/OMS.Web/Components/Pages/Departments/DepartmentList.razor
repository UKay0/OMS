@page "/departments"
@attribute [Authorize]
@rendermode InteractiveServer
@using OMS.Application.Dtos
@using OMS.Application.Interfaces
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Departments - OMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0"><i class="bi bi-diagram-3-fill me-2 text-primary"></i>Departments</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" href="departments/merge">
            <i class="bi bi-arrow-left-right"></i>Merge Departments
        </a>
        <a class="btn btn-primary" href="departments/edit">
            <i class="bi bi-plus-lg"></i>Add Department
        </a>
    </div>
</div>

@if (departments is null)
{
    <p><em>Loading...</em></p>
}
else if (departments.Count == 0)
{
    <p class="text-muted">No departments yet.</p>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var department in departments)
                {
                    <tr>
                        <td>@department.Name</td>
                        <td>@department.Code</td>
                        <td>
                            @if (department.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"departments/edit/{department.Id}")">
                                <i class="bi bi-pencil-fill"></i>Edit
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(department)">
                                <i class="bi bi-trash-fill"></i>Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<DepartmentDto>? departments;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        departments = await DepartmentService.GetAllAsync();
    }

    private async Task DeleteAsync(DepartmentDto department)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete department '{department.Name}'?");
        if (!confirmed)
        {
            return;
        }

        await DepartmentService.DeleteAsync(department.Id);
        await LoadAsync();
    }
}
