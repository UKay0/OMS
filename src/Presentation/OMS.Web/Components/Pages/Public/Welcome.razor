@page "/welcome"
@attribute [AllowAnonymous]
@layout OMS.Web.Components.Layout.EmptyLayout

<PageTitle>Welcome - OMS</PageTitle>

<div class="card shadow-lg" style="max-width: 480px;">
    <div class="card-body text-center p-5">
        <span class="app-icon d-inline-flex mb-3" style="width:56px;height:56px;font-size:1.6rem;"><i class="bi bi-kanban-fill"></i></span>
        <h1 class="h3 mb-3">OMS</h1>
        <p class="text-muted">Manage your organization's employees and departments in one place.</p>
        <a class="btn btn-primary" href="login">
            <i class="bi bi-box-arrow-in-right"></i>Sign In
        </a>
    </div>
</div>
