@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using OMS.Application.Interfaces
@inject IUserService UserService

<PageTitle>User Management - OMS</PageTitle>

<h1><i class="bi bi-shield-lock-fill me-2 text-primary"></i>User Management</h1>
<p class="text-muted">Manage the accounts that can sign in to OMS and their roles.</p>

@if (users is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Display Name</th>
                    <th>Role</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.DisplayName</td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "text-bg-primary" : "text-bg-secondary")">@user.Role</span>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<OMS.Application.Dtos.UserDto>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetAllAsync();
    }
}
