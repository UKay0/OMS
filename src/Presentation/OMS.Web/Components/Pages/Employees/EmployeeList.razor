@page "/employees"
@attribute [Authorize]
@rendermode InteractiveServer
@using OMS.Application.Dtos
@using OMS.Application.Interfaces
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS

@* Reference implementation of the "edit via modal" CRUD pattern: both Add and Edit
   open EmployeeFormModal in place, so the list never navigates away. Compare with
   DepartmentList.razor for the "edit via dedicated page" alternative. *@

<PageTitle>Employees - OMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Employees</h1>
    <button class="btn btn-primary" @onclick="() => modal?.OpenForAdd()">Add Employee</button>
</div>

@if (employees is null)
{
    <p><em>Loading...</em></p>
}
else if (employees.Count == 0)
{
    <p class="text-muted">No employees yet.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Role</th>
                <th>Active</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in employees)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>@employee.Department</td>
                    <td>@employee.Role</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => modal?.OpenForEdit(employee)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(employee)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<EmployeeFormModal @ref="modal" OnSaved="LoadAsync" />

@code {
    private IReadOnlyList<EmployeeDto>? employees;
    private EmployeeFormModal? modal;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        employees = await EmployeeService.GetAllAsync();
    }

    private async Task DeleteAsync(EmployeeDto employee)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete employee '{employee.Name}'?");
        if (!confirmed)
        {
            return;
        }

        await EmployeeService.DeleteAsync(employee.Id);
        await LoadAsync();
    }
}
